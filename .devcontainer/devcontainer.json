{
    "name": "Node.js",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
			"VARIANT": "18-bullseye"
        }
    },
    "postStartCommand": "npm install",
    "settings": {},
	"extensions": [
        "dbaeumer.vscode-eslint",
        "eamodio.gitlens",
        "GitHub.copilot",
        "GitHub.vscode-pull-request-github",
        "mhutchie.git-graph",
		"me-dutour-mathieu.vscode-github-actions",
        "esbenp.prettier-vscode"
    ],
    "remoteUser": "node",
    "features": {
        "github-cli": "latest"
    }
}